{
  "name": "dhaka-tesla-pool-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express + PostgreSQL API for Dhaka Tesla Pool",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "start": "node src/server.js",
    "migrate": "node --env-file-if-exists=../.env src/db/cli.js migrate",
    "migrate:rollback": "node --env-file-if-exists=../.env src/db/cli.js rollback",
    "seed": "node --env-file-if-exists=../.env src/db/cli.js seed",
    "db:reset": "node --env-file-if-exists=../.env src/db/cli.js reset",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "vitest": "^5.0.1"
  }
}

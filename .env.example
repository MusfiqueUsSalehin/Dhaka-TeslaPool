# Copy to .env and adjust. Never commit the real .env.

# --- API ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Local Postgres (docker compose maps it to localhost:5432)
DATABASE_URL=postgres://tesla:tesla@localhost:5432/tesla_pool
# Set true for hosted Postgres that requires TLS (e.g. Neon)
DATABASE_SSL=false

# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# true when served over HTTPS (production)
COOKIE_SECURE=false

# Run migrations + seed the story cast when the container starts
SEED_ON_START=false

# --- docker compose only ---
POSTGRES_USER=tesla
POSTGRES_PASSWORD=tesla
POSTGRES_DB=tesla_pool
# Host port for the compose database (change if 5432 is taken)
POSTGRES_PORT=5432
